# Reverse proxy partagé. Un bloc par site.
#
# --- Kcal-El --------------------------------------------------------
# HTTPS automatique (Let's Encrypt) : le DNS `A` de kcal-el.kevincelie.fr
# doit pointer vers l'IP du VPS, et les ports 80/443 doivent être ouverts.
kcal-el.kevincelie.fr {
	reverse_proxy kcal-el-api:3000
}

