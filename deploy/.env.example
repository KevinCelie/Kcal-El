# Copier vers deploy/.env (jamais commité) et remplir avec de vraies valeurs.
# Générer un mot de passe fort : openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Optionnel — sinon une valeur de dev est utilisée (à changer en prod).
JWT_SECRET=change-me-too

# À mettre à true dès que le site est servi en HTTPS (cookies d'auth Secure).
COOKIE_SECURE=true
